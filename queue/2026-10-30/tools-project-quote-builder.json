{
 "lane": "tools",
 "slug": "project-quote-builder",
 "title": "Project Quote Builder",
 "description": "List the work, add a buffer for hidden time, and get a clean project quote with tax, deposit and payment schedule you can copy straight into an email or proposal. Runs fully in your browser.",
 "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Project Quote Builder</title>\n<style>\n:root{--bg:#fbfaf7;--card:#ffffff;--fg:#22212b;--dim:#6b6878;--line:#e4e1d8;--accent:#2f8a4c;--soft:#eef6f0;--warn:#a6551c}\n@media (prefers-color-scheme:dark){:root{--bg:#17161f;--card:#201f2b;--fg:#ebe8df;--dim:#a19db0;--line:#33313f;--accent:#4fbf74;--soft:#1f2d24;--warn:#e39a62}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:24px 16px 48px}\nh1{margin:0 0 4px;font-size:28px}\nh2{font-size:18px;margin:28px 0 10px}\np.lead{margin:0 0 20px;color:var(--dim)}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}\nlabel{display:block;font-size:14px;font-weight:600}\nlabel span{display:block;font-weight:400;color:var(--dim);font-size:13px}\ninput,select,textarea{width:100%;margin-top:6px;padding:10px;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--fg)}\ninput:focus,select:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:1px}\n.items{display:flex;flex-direction:column;gap:10px}\n.row{display:grid;grid-template-columns:1fr 130px 110px 100px 40px;gap:8px;align-items:end;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--card)}\n.row input,.row select{margin-top:4px}\n.row .cost{font-variant-numeric:tabular-nums;text-align:right;padding-bottom:10px;font-weight:600}\n.row small{font-size:12px;color:var(--dim)}\n@media (max-width:640px){.row{grid-template-columns:1fr 1fr}.row .name{grid-column:1/-1}.row .cost{text-align:left}}\nbutton{font:inherit;padding:10px 14px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--fg);cursor:pointer}\nbutton.primary{background:var(--accent);border-color:var(--accent);color:#fff}\nbutton.x{padding:8px 0;width:40px;color:var(--dim)}\nbutton:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.bar{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\n.out{margin-top:24px;padding:18px;border-radius:8px;background:var(--soft);display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}\n.out div b{display:block;font-size:26px;font-variant-numeric:tabular-nums}\n.out div small{color:var(--dim)}\ntable{width:100%;border-collapse:collapse;margin-top:14px;font-variant-numeric:tabular-nums}\ntd{padding:8px 4px;border-bottom:1px solid var(--line)}td:last-child{text-align:right}\ntr.total td{font-weight:700;border-bottom:2px solid var(--fg)}\ntextarea{min-height:280px;font:14px/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}\n.note{font-size:14px;color:var(--dim);margin-top:18px}\n.warn{color:var(--warn);font-size:14px;margin-top:8px}\n#copied{color:var(--accent);font-size:14px;align-self:center}\n</style></head>\n<body><main>\n<h1>Project Quote Builder</h1>\n<p class=\"lead\">List the work, add a buffer for the hidden time, and get a clean quote with deposit and payment schedule you can paste into an email or proposal.</p>\n\n<h2>1. The basics</h2>\n<div class=\"grid\">\n<label for=\"client\">Client<input id=\"client\" type=\"text\" value=\"Harbour Lane Physio\"></label>\n<label for=\"project\">Project<input id=\"project\" type=\"text\" value=\"Website refresh\"></label>\n<label for=\"rate\">Hourly rate<span>Used for hour-based items</span><input id=\"rate\" type=\"number\" min=\"0\" step=\"5\" value=\"75\"></label>\n<label for=\"cur\">Currency symbol<input id=\"cur\" type=\"text\" maxlength=\"4\" value=\"$\"></label>\n</div>\n\n<h2>2. Line items</h2>\n<div class=\"items\" id=\"items\"></div>\n<div class=\"bar\"><button id=\"add\" type=\"button\">+ Add item</button><button id=\"example\" type=\"button\">Load example</button><button id=\"clear\" type=\"button\">Clear all</button></div>\n\n<h2>3. Adjustments and terms</h2>\n<div class=\"grid\">\n<label for=\"buffer\">Buffer (%)<span>Calls, emails, revisions, surprises. 15-25% is typical.</span><input id=\"buffer\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"20\"></label>\n<label for=\"discount\">Discount (%)<span>Optional. Leave at 0 if none.</span><input id=\"discount\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"0\"></label>\n<label for=\"tax\">Sales tax / VAT (%)<span>Only if you charge it. 0 if not.</span><input id=\"tax\" type=\"number\" min=\"0\" max=\"50\" step=\"0.5\" value=\"0\"></label>\n<label for=\"round\">Round total to<select id=\"round\"><option value=\"1\">Nearest 1</option><option value=\"10\">Nearest 10</option><option value=\"50\" selected>Nearest 50</option><option value=\"100\">Nearest 100</option></select></label>\n<label for=\"deposit\">Deposit (%)<span>Due before work starts</span><input id=\"deposit\" type=\"number\" min=\"0\" max=\"100\" step=\"5\" value=\"50\"></label>\n<label for=\"split\">Remaining balance paid in<select id=\"split\"><option value=\"1\">1 payment</option><option value=\"2\">2 payments</option><option value=\"3\">3 payments</option></select></label>\n<label for=\"days\">Invoice terms (days)<input id=\"days\" type=\"number\" min=\"0\" max=\"120\" step=\"1\" value=\"14\"></label>\n<label for=\"valid\">Quote valid for (days)<input id=\"valid\" type=\"number\" min=\"1\" max=\"120\" step=\"1\" value=\"14\"></label>\n</div>\n\n<div class=\"out\" aria-live=\"polite\">\n<div><small>Quote total</small><b id=\"oTotal\">-</b></div>\n<div><small>Deposit</small><b id=\"oDep\">-</b></div>\n<div><small>Total hours (with buffer)</small><b id=\"oHours\">-</b></div>\n<div><small>Effective hourly rate</small><b id=\"oEff\">-</b></div>\n</div>\n<p class=\"warn\" id=\"warn\" hidden></p>\n\n<table id=\"breakdown\"></table>\n\n<h2>4. Your quote, ready to paste</h2>\n<textarea id=\"text\" readonly aria-label=\"Quote text\"></textarea>\n<div class=\"bar\"><button class=\"primary\" id=\"copy\" type=\"button\">Copy quote</button><span id=\"copied\" hidden>Copied</span></div>\n\n<p class=\"note\">How it works: hour-based items are hours x your rate. Fixed items are a set price. The buffer is added to hour-based items only, since fixed prices should already include it. Discount comes off the subtotal, then tax is added, then the total is rounded. Everything runs in your browser; nothing is saved or sent anywhere, so copy your quote before closing the page. This is a pricing aid, not tax or legal advice.</p>\n</main>\n<script>\n(function(){\nvar $=function(id){return document.getElementById(id)};\nvar itemsEl=$(\"items\");\nvar EXAMPLE=[[\"Discovery call and plan\",\"h\",4],[\"Two page designs\",\"h\",8],[\"Build 6 pages and move content\",\"h\",16],[\"FAQ page\",\"h\",3],[\"Rewrite service pages\",\"h\",5],[\"Launch, checks and training\",\"h\",4],[\"Premium theme licence\",\"f\",90]];\nfunction num(v){var n=parseFloat(v);return isFinite(n)&&n>0?n:0}\nfunction money(n){var c=$(\"cur\").value||\"\";var s=Math.round(n*100)/100;var parts=s.toFixed(2).split(\".\");parts[0]=parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g,\",\");var t=parts[1]===\"00\"?parts[0]:parts.join(\".\");return c+t}\nfunction addRow(name,type,qty){\nvar r=document.createElement(\"div\");r.className=\"row\";\nr.innerHTML='<label class=\"name\">Item<input type=\"text\" class=\"n\" placeholder=\"What you will do\"></label>'+\n'<label>Priced by<select class=\"t\"><option value=\"h\">Hours</option><option value=\"f\">Fixed price</option></select></label>'+\n'<label><span class=\"ql\">Hours</span><input type=\"number\" class=\"q\" min=\"0\" step=\"0.5\"></label>'+\n'<div class=\"cost\"><small>Cost</small><br><span class=\"c\">-</span></div>'+\n'<button type=\"button\" class=\"x\" aria-label=\"Remove item\">&#10005;</button>';\nr.querySelector(\".n\").value=name||\"\";\nr.querySelector(\".t\").value=type||\"h\";\nr.querySelector(\".q\").value=qty==null?\"\":qty;\nr.querySelector(\".x\").addEventListener(\"click\",function(){r.remove();calc()});\nr.addEventListener(\"input\",calc);r.addEventListener(\"change\",calc);\nitemsEl.appendChild(r);\n}\nfunction load(list){itemsEl.innerHTML=\"\";list.forEach(function(i){addRow(i[0],i[1],i[2])});calc()}\nfunction calc(){\nvar rate=num($(\"rate\").value),buf=num($(\"buffer\").value)/100,disc=Math.min(num($(\"discount\").value),100)/100,tax=num($(\"tax\").value)/100;\nvar step=num($(\"round\").value)||1,depP=Math.min(num($(\"deposit\").value),100)/100,split=parseInt($(\"split\").value,10)||1;\nvar hours=0,hourCost=0,fixed=0,lines=[];\nArray.prototype.forEach.call(itemsEl.children,function(r){\nvar t=r.querySelector(\".t\").value,q=num(r.querySelector(\".q\").value),n=r.querySelector(\".n\").value.trim()||\"Untitled item\";\nr.querySelector(\".ql\").textContent=t===\"h\"?\"Hours\":\"Price\";\nvar c=t===\"h\"?q*rate:q;\nr.querySelector(\".c\").textContent=money(c);\nif(t===\"h\"){hours+=q;hourCost+=c}else{fixed+=c}\nif(q>0)lines.push({n:n,t:t,q:q,c:c});\n});\nvar bufCost=hourCost*buf,sub=hourCost+bufCost+fixed,discAmt=sub*disc,afterDisc=sub-discAmt,taxAmt=afterDisc*tax,raw=afterDisc+taxAmt;\nvar total=raw>0?Math.round(raw/step)*step:0;if(raw>0&&total===0)total=step;\nvar dep=Math.round(total*depP*100)/100,rest=total-dep;\nvar totHours=hours*(1+buf);\nvar preTax=tax>0?total/(1+tax):total;\nvar eff=totHours>0?(preTax-fixed*(1-disc))/totHours:0;\n$(\"oTotal\").textContent=money(total);$(\"oDep\").textContent=money(dep);\n$(\"oHours\").textContent=(Math.round(totHours*10)/10)+\" h\";$(\"oEff\").textContent=totHours>0?money(eff):\"-\";\nvar w=[];if(rate>0&&totHours>0&&eff<rate*0.9)w.push(\"Your discount brings your effective rate below your hourly rate. Consider removing scope instead of cutting the price.\");\nif(buf<0.1&&hours>0)w.push(\"A buffer under 10% is risky: most projects take longer than the estimate.\");\n$(\"warn\").hidden=!w.length;$(\"warn\").textContent=w.join(\" \");\nvar rows=[[\"Hour-based work (\"+hours+\" h x \"+money(rate)+\")\",hourCost],[\"Buffer (\"+Math.round(buf*100)+\"%)\",bufCost]];\nif(fixed>0)rows.push([\"Fixed-price items\",fixed]);\nif(disc>0)rows.push([\"Discount (\"+Math.round(disc*100)+\"%)\",-discAmt]);\nif(tax>0)rows.push([\"Tax (\"+(tax*100)+\"%)\",taxAmt]);\nif(Math.abs(total-raw)>0.004)rows.push([\"Rounding\",total-raw]);\nvar tb=$(\"breakdown\");tb.innerHTML=\"\";\nrows.forEach(function(x){var tr=document.createElement(\"tr\");var a=document.createElement(\"td\");a.textContent=x[0];var b=document.createElement(\"td\");b.textContent=(x[1]<0?\"-\":\"\")+money(Math.abs(x[1]));tr.appendChild(a);tr.appendChild(b);tb.appendChild(tr)});\nvar tr=document.createElement(\"tr\");tr.className=\"total\";tr.innerHTML=\"<td>Total</td><td></td>\";tr.lastChild.textContent=money(total);tb.appendChild(tr);\nvar d=new Date();var vd=new Date(d.getTime()+num($(\"valid\").value)*864e5);\nvar fmt=function(x){return x.toLocaleDateString(undefined,{day:\"numeric\",month:\"long\",year:\"numeric\"})};\nvar L=[];\nL.push(\"QUOTE: \"+($(\"project\").value.trim()||\"Project\"));\nL.push(\"For: \"+($(\"client\").value.trim()||\"Client\"));\nL.push(\"Date: \"+fmt(d)+\"   Valid until: \"+fmt(vd));\nL.push(\"\");L.push(\"WHAT'S INCLUDED\");\nvar allocBuf=1+buf;\nlines.forEach(function(l){var c=l.t===\"h\"?l.c*allocBuf:l.c;L.push(\"- \"+l.n+(l.t===\"h\"?\" (\"+(Math.round(l.q*allocBuf*10)/10)+\" h)\":\"\")+\": \"+money(c))});\nL.push(\"\");\nL.push(\"Subtotal: \"+money(sub));\nif(disc>0)L.push(\"Discount (\"+Math.round(disc*100)+\"%): -\"+money(discAmt));\nif(tax>0)L.push(\"Tax (\"+(tax*100)+\"%): \"+money(taxAmt));\nif(Math.abs(total-raw)>0.004)L.push(\"Rounding: \"+(total-raw<0?\"-\":\"\")+money(Math.abs(total-raw)));\nL.push(\"TOTAL: \"+money(total));\nL.push(\"\");L.push(\"PAYMENT\");\nvar days=Math.round(num($(\"days\").value));\nif(dep>0)L.push(\"- Deposit (\"+Math.round(depP*100)+\"%): \"+money(dep)+\", due before work starts\");\nif(rest>0.004){\nif(split===1){L.push(\"- Balance: \"+money(rest)+\", due on final delivery\")}\nelse{var each=Math.floor(rest/split*100)/100,last=Math.round((rest-each*(split-1))*100)/100;\nfor(var i=1;i<=split;i++){L.push(\"- Payment \"+i+\" of \"+split+\": \"+money(i===split?last:each)+(i===split?\", due on final delivery\":\", due at milestone \"+i))}}\n}\nL.push(\"Invoices are due within \"+days+\" days of issue.\");\nL.push(\"\");L.push(\"Hours include a \"+Math.round(buf*100)+\"% allowance for calls, revisions and project management.\");\nL.push(\"Work outside the items above will be quoted separately before it starts.\");\nL.push(\"To accept, reply to this email and I'll send the agreement and deposit invoice.\");\n$(\"text\").value=L.join(\"\\n\");\n}\n$(\"add\").addEventListener(\"click\",function(){addRow(\"\",\"h\",\"\");calc();var r=itemsEl.lastChild;if(r)r.querySelector(\".n\").focus()});\n$(\"example\").addEventListener(\"click\",function(){load(EXAMPLE)});\n$(\"clear\").addEventListener(\"click\",function(){load([[\"\",\"h\",\"\"]])});\n[\"client\",\"project\",\"rate\",\"cur\",\"buffer\",\"discount\",\"tax\",\"round\",\"deposit\",\"split\",\"days\",\"valid\"].forEach(function(id){$(id).addEventListener(\"input\",calc);$(id).addEventListener(\"change\",calc)});\n$(\"copy\").addEventListener(\"click\",function(){\nvar t=$(\"text\");var done=function(){$(\"copied\").hidden=false;setTimeout(function(){$(\"copied\").hidden=true},1800)};\nif(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t.value).then(done,function(){t.select();document.execCommand(\"copy\");done()})}\nelse{t.select();document.execCommand(\"copy\");done()}\n});\nload(EXAMPLE);\n})();\n</script>\n</body></html>\n"
}