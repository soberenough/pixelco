{
 "lane": "tools",
 "slug": "freelance-client-profitability-ranker",
 "title": "Which Clients Are Worth Keeping? Freelance Client Profitability Ranker",
 "description": "Enter what each client paid you and the hours they really took, including calls, emails, revisions and invoice chasing. See every client ranked by effective hourly rate against your target, their share of your income, a keep, re-price or let-go verdict, the fee that would make each one worth it, and how many hours you would need to replace them. Copy as CSV. Runs in your browser, nothing is sent anywhere.",
 "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Which Clients Are Worth Keeping? Freelance Client Profitability Ranker</title>\n<style>\n:root{--bg:#f7f7f4;--card:#fff;--ink:#1d1f23;--muted:#5d636d;--line:#dcdfe4;--accent:#2457c5;--good:#17794a;--warn:#a66300;--bad:#b3261e;--goodbg:#e6f4ec;--warnbg:#fdf1de;--badbg:#fbe7e5;--input:#fff}\n@media (prefers-color-scheme:dark){:root{--bg:#15171a;--card:#1f2226;--ink:#eceef1;--muted:#a3a9b3;--line:#363a41;--accent:#7ea6ff;--good:#5fd39a;--warn:#f0b35a;--bad:#ff8a80;--goodbg:#1b3428;--warnbg:#3a2d17;--badbg:#3d1f1d;--input:#16181b}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:980px;margin:0 auto;padding:20px 16px 48px}\nh1{font-size:1.6rem;line-height:1.25;margin:.2em 0 .3em}\nh2{font-size:1.15rem;margin:0 0 .6em}\np.lead{color:var(--muted);margin:0 0 1.2em}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin:0 0 16px}\n.row{display:flex;flex-wrap:wrap;gap:12px}\n.row label{flex:1 1 180px}\nlabel{display:block;font-size:.85rem;color:var(--muted)}\ninput,select{width:100%;font:inherit;color:var(--ink);background:var(--input);border:1px solid var(--line);border-radius:8px;padding:8px 10px;margin-top:3px}\ninput:focus,select:focus,button:focus{outline:2px solid var(--accent);outline-offset:1px}\nbutton{font:inherit;border:1px solid var(--accent);background:var(--accent);color:#fff;border-radius:8px;padding:8px 14px;cursor:pointer}\nbutton.ghost{background:transparent;color:var(--accent)}\nbutton.x{background:transparent;border:1px solid var(--line);color:var(--muted);padding:6px 10px}\n.client{border:1px solid var(--line);border-radius:10px;padding:12px;margin:0 0 10px}\n.client .head{display:flex;gap:8px;align-items:flex-end}\n.client .head label{flex:1}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:10px}\n.hint{font-size:.82rem;color:var(--muted);margin:.4em 0 0}\n.tablewrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-size:.92rem}\nth,td{text-align:left;padding:8px;border-bottom:1px solid var(--line);vertical-align:top}\nth{font-size:.8rem;color:var(--muted);font-weight:600}\ntd.num,th.num{text-align:right;white-space:nowrap}\n.tag{display:inline-block;border-radius:999px;padding:2px 10px;font-size:.8rem;font-weight:600;white-space:nowrap}\n.keep{background:var(--goodbg);color:var(--good)}\n.fix{background:var(--warnbg);color:var(--warn)}\n.go{background:var(--badbg);color:var(--bad)}\n.bar{height:8px;border-radius:4px;background:var(--line);margin-top:4px;min-width:60px}\n.bar span{display:block;height:100%;border-radius:4px}\n.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:14px}\n.stat{border:1px solid var(--line);border-radius:10px;padding:10px 12px}\n.stat b{display:block;font-size:1.3rem}\n.stat small{color:var(--muted)}\nul.advice{padding-left:1.2em;margin:.4em 0 0}\nul.advice li{margin:.35em 0}\n.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}\n.note{font-size:.82rem;color:var(--muted)}\n.empty{color:var(--muted);font-style:italic}\n</style>\n</head>\n<body>\n<main>\n<h1>Which clients are worth keeping?</h1>\n<p class=\"lead\">Rank your freelance clients by what they really pay per hour once calls, emails, revisions and invoice chasing are counted. See who to keep, who to re-price, and what letting one go would actually cost you. Everything runs in your browser and nothing is sent anywhere.</p>\n\n<section class=\"card\">\n<h2>1. Your numbers</h2>\n<div class=\"row\">\n<label>Period these figures cover\n<select id=\"months\">\n<option value=\"1\">Last 1 month</option>\n<option value=\"3\" selected>Last 3 months</option>\n<option value=\"6\">Last 6 months</option>\n<option value=\"12\">Last 12 months</option>\n</select></label>\n<label>Your target hourly rate\n<input id=\"target\" type=\"number\" min=\"1\" step=\"1\" value=\"75\" inputmode=\"decimal\"></label>\n<label>Currency symbol\n<input id=\"cur\" type=\"text\" maxlength=\"3\" value=\"$\"></label>\n</div>\n<p class=\"hint\">Target rate = what you'd quote a good new client today.</p>\n</section>\n\n<section class=\"card\">\n<h2>2. Your clients</h2>\n<p class=\"hint\" style=\"margin-top:0\">For each client, enter what they paid you in the period and the hours you spent. Split the hours into the work itself and everything else (calls, emails, meetings, revisions beyond scope, chasing payments, waiting around). Estimates are fine.</p>\n<div id=\"clients\"></div>\n<div class=\"actions\">\n<button type=\"button\" id=\"add\">+ Add client</button>\n<button type=\"button\" class=\"ghost\" id=\"example\">Load example</button>\n<button type=\"button\" class=\"ghost\" id=\"clear\">Clear all</button>\n</div>\n</section>\n\n<section class=\"card\" id=\"results\">\n<h2>3. Results</h2>\n<div id=\"out\"><p class=\"empty\">Add at least one client with money and hours to see results.</p></div>\n<div class=\"actions\">\n<button type=\"button\" class=\"ghost\" id=\"copy\">Copy as CSV</button>\n<span id=\"copied\" class=\"note\" aria-live=\"polite\"></span>\n</div>\n</section>\n\n<section class=\"card\">\n<h2>How the verdicts work</h2>\n<ul class=\"advice\">\n<li><b>Effective rate</b> = money received ÷ all hours (work + overhead).</li>\n<li><span class=\"tag keep\">Keep</span> effective rate at least 90% of your target, payment usually within 2 weeks of the due date and stress below 4 out of 5.</li>\n<li><span class=\"tag fix\">Re-price or fix</span> effective rate 60-89% of target, or one problem (slow payment, high overhead or high stress) on an otherwise decent client. The tool shows the rate that would bring them up to target at the same hours.</li>\n<li><span class=\"tag go\">Consider letting go</span> effective rate under 60% of target, or two or more problems at once.</li>\n<li><b>Hours to replace</b> = the client's income ÷ your target rate: how much work at your target rate would earn the same money.</li>\n</ul>\n<p class=\"note\">This is a planning aid, not financial advice. A verdict is a starting point for a decision only you can make: a low-paying client may still be worth keeping for portfolio, learning or relationship reasons.</p>\n</section>\n</main>\n\n<script>\n(function(){\nvar list=document.getElementById('clients');\nvar out=document.getElementById('out');\nvar lastRows=[];\n\nfunction el(tag,attrs,html){var e=document.createElement(tag);if(attrs){for(var k in attrs){e.setAttribute(k,attrs[k]);}}if(html!==undefined){e.innerHTML=html;}return e;}\nfunction esc(s){return String(s).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\nfunction num(v){var n=parseFloat(v);return isFinite(n)?n:0;}\nfunction cur(){return document.getElementById('cur').value||'';}\nfunction money(n){return cur()+Math.round(n).toLocaleString();}\nfunction rate(n){return cur()+(Math.round(n*10)/10).toLocaleString(undefined,{maximumFractionDigits:1});}\n\nfunction addClient(d){\nd=d||{};\nvar box=el('div',{'class':'client'});\nbox.innerHTML=\n'<div class=\"head\"><label>Client name<input data-k=\"name\" type=\"text\" placeholder=\"e.g. Agency A\"></label>'+\n'<button type=\"button\" class=\"x\" aria-label=\"Remove client\">Remove</button></div>'+\n'<div class=\"grid\">'+\n'<label>Money received<input data-k=\"paid\" type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\"></label>'+\n'<label>Work hours<input data-k=\"work\" type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\"></label>'+\n'<label>Overhead hours<input data-k=\"over\" type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\"></label>'+\n'<label>Avg days paid late<input data-k=\"late\" type=\"number\" min=\"0\" step=\"1\" inputmode=\"numeric\" placeholder=\"0\"></label>'+\n'<label>Stress (1 low - 5 high)<select data-k=\"stress\"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select></label>'+\n'</div>';\nvar fields=box.querySelectorAll('[data-k]');\nfor(var i=0;i<fields.length;i++){var k=fields[i].getAttribute('data-k');if(d[k]!==undefined){fields[i].value=d[k];}}\nbox.querySelector('button.x').addEventListener('click',function(){box.remove();calc();});\nlist.appendChild(box);\n}\n\nfunction read(){\nvar rows=[];var boxes=list.querySelectorAll('.client');\nfor(var i=0;i<boxes.length;i++){\nvar r={};var f=boxes[i].querySelectorAll('[data-k]');\nfor(var j=0;j<f.length;j++){r[f[j].getAttribute('data-k')]=f[j].value;}\nr.name=(r.name||'').trim()||('Client '+(i+1));\nr.paid=num(r.paid);r.work=num(r.work);r.over=num(r.over);r.late=num(r.late);r.stress=num(r.stress)||3;\nr.hours=r.work+r.over;\nif(r.paid>0&&r.hours>0){rows.push(r);}\n}\nreturn rows;\n}\n\nfunction calc(){\nvar target=num(document.getElementById('target').value);\nvar months=num(document.getElementById('months').value)||1;\nvar rows=read();\nif(!rows.length||target<=0){out.innerHTML='<p class=\"empty\">Add at least one client with money and hours (and a target rate) to see results.</p>';lastRows=[];return;}\nvar totalPaid=0,totalHours=0;\nrows.forEach(function(r){totalPaid+=r.paid;totalHours+=r.hours;});\nrows.forEach(function(r){\nr.eff=r.paid/r.hours;\nr.pct=r.eff/target*100;\nr.share=r.paid/totalPaid*100;\nr.overPct=r.over/r.hours*100;\nr.needed=target*r.hours;\nr.raise=r.needed>r.paid?(r.needed/r.paid-1)*100:0;\nr.replaceHrs=r.paid/target;\nr.freed=r.hours-r.replaceHrs;\nvar problems=[];\nif(r.late>14){problems.push('pays '+Math.round(r.late)+' days late');}\nif(r.overPct>=35){problems.push(Math.round(r.overPct)+'% of hours are overhead');}\nif(r.stress>=4){problems.push('high stress');}\nr.problems=problems;\nif(r.pct<60||problems.length>=2){r.verdict='go';}\nelse if(r.pct<90||problems.length===1){r.verdict='fix';}\nelse{r.verdict='keep';}\n});\nrows.sort(function(a,b){return b.eff-a.eff;});\nlastRows=rows;\n\nvar avg=totalPaid/totalHours;\nvar maxEff=rows[0].eff;\nvar worst=rows[rows.length-1];\nvar labels={keep:'Keep',fix:'Re-price or fix',go:'Consider letting go'};\n\nvar h='<div class=\"stats\">'+\n'<div class=\"stat\"><small>Total income ('+months+' mo)</small><b>'+money(totalPaid)+'</b></div>'+\n'<div class=\"stat\"><small>Total hours</small><b>'+Math.round(totalHours).toLocaleString()+'</b></div>'+\n'<div class=\"stat\"><small>Average effective rate</small><b>'+rate(avg)+'/hr</b><small>'+Math.round(avg/target*100)+'% of your '+rate(target)+' target</small></div>'+\n'<div class=\"stat\"><small>Income per month</small><b>'+money(totalPaid/months)+'</b></div>'+\n'</div>';\n\nh+='<div class=\"tablewrap\"><table><thead><tr><th>#</th><th>Client</th><th class=\"num\">Effective rate</th><th class=\"num\">vs target</th><th class=\"num\">Share of income</th><th class=\"num\">Overhead</th><th>Verdict</th></tr></thead><tbody>';\nrows.forEach(function(r,i){\nvar col=r.verdict==='keep'?'var(--good)':(r.verdict==='fix'?'var(--warn)':'var(--bad)');\nh+='<tr><td>'+(i+1)+'</td><td>'+esc(r.name)+'<div class=\"bar\"><span style=\"width:'+Math.max(4,r.eff/maxEff*100).toFixed(1)+'%;background:'+col+'\"></span></div></td>'+\n'<td class=\"num\">'+rate(r.eff)+'/hr</td><td class=\"num\">'+Math.round(r.pct)+'%</td><td class=\"num\">'+Math.round(r.share)+'%</td><td class=\"num\">'+Math.round(r.overPct)+'%</td>'+\n'<td><span class=\"tag '+r.verdict+'\">'+labels[r.verdict]+'</span></td></tr>';\n});\nh+='</tbody></table></div>';\n\nh+='<h2 style=\"margin-top:18px\">What this means</h2><ul class=\"advice\">';\nrows.forEach(function(r){\nvar line='<b>'+esc(r.name)+':</b> ';\nif(r.verdict==='keep'){\nline+='earns '+rate(r.eff)+'/hr, at or near your target. Protect this relationship.';\nif(r.problems.length){line+=' Watch: '+r.problems.join(', ')+'.';}\n}else{\nif(r.raise>0){line+='to reach your target at the same hours they would need to pay about '+money(r.needed/months)+' per month instead of '+money(r.paid/months)+' (+'+Math.round(r.raise)+'%). ';}\nif(r.problems.length){line+='Problems: '+r.problems.join(', ')+'. ';}\nif(r.overPct>=35){line+='Cutting overhead (one channel, fixed revision rounds, deposits) may fix more than a rate rise. ';}\nline+='Replacing their '+money(r.paid/months)+'/month at your target rate takes about '+(Math.round(r.replaceHrs/months*10)/10)+' hrs/month';\nif(r.freed>0){line+=', freeing roughly '+(Math.round(r.freed/months*10)/10)+' hrs/month';}\nline+='.';\nif(r.share>=40){line+=' They are '+Math.round(r.share)+'% of your income, so line up new work before making changes.';}\n}\nh+='<li>'+line+'</li>';\n});\nh+='</ul>';\n\nif(rows.length>1&&worst.verdict!=='keep'){\nvar withoutPaid=totalPaid-worst.paid,withoutHours=totalHours-worst.hours;\nif(withoutHours>0){\nh+='<p class=\"note\" style=\"margin-top:12px\">Without <b>'+esc(worst.name)+'</b>, your average effective rate would be '+rate(withoutPaid/withoutHours)+'/hr instead of '+rate(avg)+'/hr, with '+Math.round(worst.hours/months)+' hours a month back to fill with better-paid work or rest.</p>';\n}\n}\nout.innerHTML=h;\n}\n\nfunction toCSV(){\nif(!lastRows.length){return '';}\nvar q=function(v){v=String(v);return /[\",\\n]/.test(v)?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;};\nvar lines=[['Rank','Client','Money received','Work hours','Overhead hours','Total hours','Effective rate','Percent of target','Share of income','Overhead percent','Avg days late','Stress','Verdict','Fee needed for target (period)','Hours to replace at target'].join(',')];\nvar labels={keep:'Keep',fix:'Re-price or fix',go:'Consider letting go'};\nlastRows.forEach(function(r,i){\nlines.push([i+1,q(r.name),r.paid,r.work,r.over,r.hours,r.eff.toFixed(2),Math.round(r.pct),Math.round(r.share),Math.round(r.overPct),r.late,r.stress,labels[r.verdict],Math.round(r.needed),r.replaceHrs.toFixed(1)].join(','));\n});\nreturn lines.join('\\n');\n}\n\ndocument.getElementById('copy').addEventListener('click',function(){\nvar t=toCSV();var msg=document.getElementById('copied');\nif(!t){msg.textContent='Nothing to copy yet.';return;}\nvar done=function(){msg.textContent='Copied. Paste into any spreadsheet.';};\nif(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(done,function(){fallback(t);done();});}\nelse{fallback(t);done();}\n});\nfunction fallback(t){var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');}catch(e){}a.remove();}\n\ndocument.getElementById('add').addEventListener('click',function(){addClient();});\ndocument.getElementById('clear').addEventListener('click',function(){list.innerHTML='';addClient();calc();});\ndocument.getElementById('example').addEventListener('click',function(){\nlist.innerHTML='';\naddClient({name:'Design agency (retainer)',paid:5400,work:58,over:8,late:0,stress:2});\naddClient({name:'Property company',paid:3600,work:48,over:27,late:30,stress:5});\naddClient({name:'Startup (project)',paid:4200,work:52,over:14,late:10,stress:3});\naddClient({name:'Local bakery',paid:900,work:14,over:9,late:5,stress:2});\ndocument.getElementById('months').value='3';document.getElementById('target').value='75';\ncalc();\n});\ndocument.addEventListener('input',calc);\ndocument.addEventListener('change',calc);\naddClient();addClient();\ncalc();\n})();\n</script>\n</body>\n</html>\n"
}