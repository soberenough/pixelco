{
 "lane": "tools",
 "slug": "unpaid-invoice-aging-tracker",
 "title": "Who Owes Me? Unpaid Invoice Aging Tracker",
 "description": "List your unpaid invoices and see who owes you what, how late each one is (current, 1-15, 16-30, 31-60, 60+ days), a ranked chase list for today, a by-client breakdown, and a reminder message matched to each invoice's lateness. Handles part payments and recent reminders. Copy as CSV. Runs in your browser, nothing is sent anywhere.",
 "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Who Owes Me? Unpaid Invoice Aging Tracker</title>\n<style>\n:root{--bg:#f7f7f5;--card:#fff;--ink:#1d1d1f;--mute:#5f6368;--line:#dcdcd8;--acc:#2f6f5e;--soft:#eef4f1;--b0:#2f6f5e;--b1:#b08900;--b2:#c26a1b;--b3:#a4372a;--b4:#6b1f17;--warnbg:#fbecea;--amberbg:#fdf3dc}\n@media (prefers-color-scheme:dark){:root{--bg:#141517;--card:#1e2023;--ink:#ececec;--mute:#a3a7ad;--line:#33363b;--acc:#6cc3a6;--soft:#1f2b27;--b0:#6cc3a6;--b1:#e6c24a;--b2:#f0954a;--b3:#f08a7a;--b4:#ff6b5a;--warnbg:#3a2220;--amberbg:#3a3020}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:20px 16px 48px}\nh1{font-size:1.5rem;margin:.2em 0}p.lead{color:var(--mute);margin-top:0;max-width:760px}\nh2{font-size:1.05rem;margin:0 0 10px}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin:0 0 16px}\nlabel{display:block;font-size:.8rem;color:var(--mute);margin-bottom:3px}\ninput,select,textarea{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit;min-width:0}\ntextarea{min-height:170px;font-size:.92rem;line-height:1.45}\n.top{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}\n.hint{font-size:.85rem;color:var(--mute);margin:6px 0 0}\n.inv{border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:10px;display:grid;grid-template-columns:repeat(9,1fr) 36px;gap:8px;align-items:end}\n.inv .c2{grid-column:span 2}\n@media (max-width:820px){.inv{grid-template-columns:1fr 1fr}.inv .c2{grid-column:span 2}.inv button.x{grid-column:span 2;width:100%}}\nbutton{font:inherit;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:8px 12px;cursor:pointer}\nbutton.primary{background:var(--acc);border-color:var(--acc);color:#fff}\n@media (prefers-color-scheme:dark){button.primary{color:#0f1a16}}\nbutton.x{padding:6px 0;width:36px;color:var(--mute)}\n.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}\n.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:12px}\n.stat{background:var(--soft);border-radius:10px;padding:10px 12px}\n.stat b{display:block;font-size:1.3rem}.stat span{font-size:.82rem;color:var(--mute)}\n.bar{display:flex;height:22px;border-radius:6px;overflow:hidden;background:var(--line);margin:6px 0 8px}\n.bar div{height:100%}\n.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:.85rem}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px}\n.tbl{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-size:.9rem}\nth,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line);vertical-align:top}\nth{color:var(--mute);font-weight:600;font-size:.8rem}\ntd.n,th.n{text-align:right;white-space:nowrap}\n.pill{display:inline-block;padding:1px 8px;border-radius:999px;font-size:.78rem;font-weight:600;color:#fff;white-space:nowrap}\n@media (prefers-color-scheme:dark){.pill{color:#141517}}\n.act{font-size:.88rem}\n.today{background:var(--amberbg)}\n.empty{color:var(--mute);font-style:italic}\n.note{font-size:.85rem;color:var(--mute)}\n</style></head>\n<body><main>\n<h1>Who Owes Me? Unpaid Invoice Aging Tracker</h1>\n<p class=\"lead\">List every invoice that has not been fully paid. You get an aging report (current, 1-15, 16-30, 31-60 and 60+ days late), a ranked list of who to chase today, and a ready-to-edit reminder message matched to how late each invoice is. Everything runs in your browser and nothing is sent anywhere.</p>\n\n<section class=\"card\">\n<h2>1. Your settings</h2>\n<div class=\"top\">\n<div><label for=\"asof\">Today's date</label><input type=\"date\" id=\"asof\"></div>\n<div><label for=\"cur\">Currency symbol</label><input id=\"cur\" value=\"$\" maxlength=\"4\"></div>\n<div><label for=\"me\">Your name (for messages)</label><input id=\"me\" placeholder=\"Sam Rivera\"></div>\n<div><label for=\"gap\">Days between reminders</label><input type=\"number\" id=\"gap\" min=\"1\" value=\"7\"></div>\n</div>\n<p class=\"hint\">\"Days between reminders\" stops the tracker nagging you to chase the same client every day. An invoice you reminded recently is shown as \"wait\" until this many days have passed.</p>\n</section>\n\n<section class=\"card\">\n<h2>2. Unpaid invoices</h2>\n<div id=\"rows\"></div>\n<div class=\"btns\">\n<button id=\"add\" class=\"primary\">+ Add invoice</button>\n<button id=\"example\">Load example</button>\n<button id=\"clear\">Clear all</button>\n</div>\n<p class=\"hint\">Partly paid? Enter what has arrived in \"Paid so far\" and the tracker ages only the balance. Delete a row once it is paid in full.</p>\n</section>\n\n<section class=\"card\">\n<h2>3. Aging summary</h2>\n<div class=\"stats\" id=\"stats\"></div>\n<div class=\"bar\" id=\"bar\"></div>\n<div class=\"legend\" id=\"legend\"></div>\n</section>\n\n<section class=\"card\">\n<h2>4. Chase list</h2>\n<p class=\"note\">Ranked by what needs you most: overdue and not reminded recently first, then by days late and size of balance.</p>\n<div class=\"tbl\"><table><thead><tr><th>Client</th><th>Invoice</th><th class=\"n\">Balance</th><th class=\"n\">Due</th><th class=\"n\">Days late</th><th>Stage</th><th>Next step</th></tr></thead><tbody id=\"chase\"></tbody></table></div>\n</section>\n\n<section class=\"card\">\n<h2>5. By client</h2>\n<div class=\"tbl\"><table><thead><tr><th>Client</th><th class=\"n\">Invoices</th><th class=\"n\">Owed</th><th class=\"n\">Overdue</th><th class=\"n\">Oldest late</th><th class=\"n\">Share of total</th></tr></thead><tbody id=\"byClient\"></tbody></table></div>\n<p class=\"note\" id=\"concNote\"></p>\n</section>\n\n<section class=\"card\">\n<h2>6. Reminder message</h2>\n<div class=\"top\">\n<div><label for=\"pick\">Write a message for</label><select id=\"pick\"></select></div>\n</div>\n<p class=\"hint\" id=\"toneHint\"></p>\n<textarea id=\"msg\" aria-label=\"Reminder message\"></textarea>\n<div class=\"btns\"><button id=\"copyMsgBtn\" class=\"primary\">Copy message</button><button id=\"copyCsv\">Copy report as CSV</button><span class=\"note\" id=\"copied\"></span></div>\n<p class=\"hint\">Messages are starting points. Edit them so they sound like you, and check any payment details before sending. This tool does not give legal advice: for collections, interest or court options, check the rules where you and your client are based.</p>\n</section>\n</main>\n<script>\n(function(){\nvar $=function(id){return document.getElementById(id)};\nvar KEY='pixelco-aging-v1';\nvar BUCKETS=[\n {k:'cur',name:'Not yet due',col:'var(--b0)'},\n {k:'b1',name:'1-15 days late',col:'var(--b1)'},\n {k:'b2',name:'16-30 days late',col:'var(--b2)'},\n {k:'b3',name:'31-60 days late',col:'var(--b3)'},\n {k:'b4',name:'60+ days late',col:'var(--b4)'}\n];\nfunction iso(d){var m=d.getMonth()+1,day=d.getDate();return d.getFullYear()+'-'+(m<10?'0':'')+m+'-'+(day<10?'0':'')+day}\nfunction parse(s){if(!s)return null;var p=s.split('-');if(p.length!==3)return null;var d=new Date(+p[0],+p[1]-1,+p[2]);return isNaN(d)?null:d}\nfunction addDays(d,n){var x=new Date(d.getTime());x.setDate(x.getDate()+n);return x}\nfunction diff(a,b){return Math.round((a-b)/86400000)}\nfunction nice(d){return d?d.toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'}):'-'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction cur(){return $('cur').value||''}\nfunction money(n){var neg=n<0;n=Math.abs(n);return (neg?'-':'')+cur()+n.toLocaleString(undefined,{minimumFractionDigits:n%1?2:0,maximumFractionDigits:2})}\n\nfunction row(v){\n v=v||{};\n var d=document.createElement('div');d.className='inv';\n d.innerHTML=\n '<div class=\"c2\"><label>Client</label><input data-f=\"client\" placeholder=\"Client name\"></div>'+\n '<div><label>Contact first name</label><input data-f=\"who\" placeholder=\"Dana\"></div>'+\n '<div><label>Invoice #</label><input data-f=\"num\" placeholder=\"INV-014\"></div>'+\n '<div><label>Amount</label><input data-f=\"amt\" type=\"number\" min=\"0\" step=\"0.01\"></div>'+\n '<div><label>Paid so far</label><input data-f=\"paid\" type=\"number\" min=\"0\" step=\"0.01\" value=\"0\"></div>'+\n '<div><label>Invoice date</label><input data-f=\"date\" type=\"date\"></div>'+\n '<div><label>Terms (days)</label><input data-f=\"terms\" type=\"number\" min=\"0\" value=\"30\"></div>'+\n '<div><label>Last reminder</label><input data-f=\"rem\" type=\"date\"></div>'+\n '<button class=\"x\" title=\"Remove this invoice\" aria-label=\"Remove this invoice\">&times;</button>';\n Object.keys(v).forEach(function(k){var el=d.querySelector('[data-f=\"'+k+'\"]');if(el&&v[k]!=null)el.value=v[k]});\n $('rows').appendChild(d);\n}\nfunction read(){\n var out=[];\n [].forEach.call(document.querySelectorAll('#rows .inv'),function(r){\n  var g=function(f){return r.querySelector('[data-f=\"'+f+'\"]').value};\n  out.push({client:g('client').trim(),who:g('who').trim(),num:g('num').trim(),amt:parseFloat(g('amt'))||0,paid:parseFloat(g('paid'))||0,date:g('date'),terms:parseInt(g('terms'),10)||0,rem:g('rem')});\n });\n return out;\n}\nfunction bucketOf(late){if(late<=0)return 0;if(late<=15)return 1;if(late<=30)return 2;if(late<=60)return 3;return 4}\nfunction stageOf(late){\n if(late<-3)return {s:'Not due',a:'Nothing to do yet.',tone:'none'};\n if(late<=0)return {s:'Due soon',a:'Send a friendly heads-up with the invoice attached.',tone:'heads'};\n if(late<=7)return {s:'Just late',a:'Polite nudge: assume it slipped through.',tone:'nudge'};\n if(late<=14)return {s:'Late',a:'Firm reminder with a clear pay-by date. Ask if anything is blocking payment.',tone:'firm'};\n if(late<=30)return {s:'Very late',a:'Call or message the person who approves payment. Consider pausing new work.',tone:'call'};\n if(late<=60)return {s:'Seriously late',a:'Final notice in writing: amount, date, and what happens next (paused work, late fee if your contract has one).',tone:'final'};\n return {s:'At risk',a:'Decide: payment plan, formal demand, or a collection or small-claims route. Check local rules first.',tone:'last'};\n}\nvar state=[],lastCSV='';\nfunction calc(){\n var asof=parse($('asof').value)||new Date();\n var gap=parseInt($('gap').value,10)||7;\n var tot=0,od=0,bs=[0,0,0,0,0],lateSum=0,lateW=0,clients={};\n state=[];\n read().forEach(function(v,i){\n  var bal=Math.max(0,v.amt-v.paid);\n  var d=parse(v.date);if(!d||bal<=0)return;\n  var due=addDays(d,v.terms),late=diff(asof,due);\n  var rem=parse(v.rem),since=rem?diff(asof,rem):null;\n  var st=stageOf(late);\n  var waiting=since!==null&&since<gap&&late>0;\n  var b=bucketOf(late);\n  tot+=bal;bs[b]+=bal;if(late>0){od+=bal;lateSum+=late*bal;lateW+=bal}\n  var c=v.client||'(no client name)';\n  if(!clients[c])clients[c]={n:0,owed:0,od:0,oldest:0};\n  clients[c].n++;clients[c].owed+=bal;if(late>0){clients[c].od+=bal;clients[c].oldest=Math.max(clients[c].oldest,late)}\n  var score=(late>-4?1000:0)+(waiting?-900:0)+Math.max(late,-30)*10+bal/100;\n  state.push({i:i,v:v,bal:bal,due:due,late:late,st:st,b:b,since:since,waiting:waiting,score:score,client:c});\n });\n state.sort(function(a,b){return b.score-a.score});\n var nOd=state.filter(function(x){return x.late>0}).length;\n $('stats').innerHTML=\n  '<div class=\"stat\"><b>'+money(tot)+'</b><span>owed to you in '+state.length+' invoice'+(state.length===1?'':'s')+'</span></div>'+\n  '<div class=\"stat\"><b>'+money(od)+'</b><span>overdue ('+(tot?Math.round(od/tot*100):0)+'% of what you are owed)</span></div>'+\n  '<div class=\"stat\"><b>'+(lateW?Math.round(lateSum/lateW):0)+' days</b><span>average lateness of overdue money, weighted by amount</span></div>'+\n  '<div class=\"stat\"><b>'+money(bs[3]+bs[4])+'</b><span>more than 30 days late, the money most at risk</span></div>';\n $('bar').innerHTML=bs.map(function(x,k){return x>0?'<div style=\"width:'+(x/tot*100)+'%;background:'+BUCKETS[k].col+'\" title=\"'+esc(BUCKETS[k].name+': '+money(x))+'\"></div>':''}).join('');\n $('legend').innerHTML=BUCKETS.map(function(B,k){return '<span><i style=\"background:'+B.col+'\"></i>'+B.name+': <b>'+money(bs[k])+'</b></span>'}).join('');\n var h='';\n state.forEach(function(x){\n  var next=x.waiting?'Wait: reminded '+x.since+' day'+(x.since===1?'':'s')+' ago. Next reminder in '+(gap-x.since)+' day'+((gap-x.since)===1?'':'s')+'.':x.st.a;\n  var hot=!x.waiting&&x.late>-4;\n  h+='<tr class=\"'+(hot?'today':'')+'\"><td>'+esc(x.client)+'</td><td>'+esc(x.v.num||'-')+'</td><td class=\"n\">'+money(x.bal)+'</td><td class=\"n\">'+nice(x.due)+'</td><td class=\"n\">'+(x.late>0?x.late:(x.late===0?'due today':Math.abs(x.late)+' to go'))+'</td><td><span class=\"pill\" style=\"background:'+BUCKETS[x.b].col+'\">'+x.st.s+'</span></td><td class=\"act\">'+esc(next)+'</td></tr>';\n });\n $('chase').innerHTML=h||'<tr><td colspan=\"7\" class=\"empty\">Add an unpaid invoice above to see who to chase.</td></tr>';\n var cl=Object.keys(clients).map(function(k){return [k,clients[k]]}).sort(function(a,b){return b[1].owed-a[1].owed});\n $('byClient').innerHTML=cl.map(function(p){var c=p[1];return '<tr><td>'+esc(p[0])+'</td><td class=\"n\">'+c.n+'</td><td class=\"n\">'+money(c.owed)+'</td><td class=\"n\">'+money(c.od)+'</td><td class=\"n\">'+(c.oldest?c.oldest+' days':'-')+'</td><td class=\"n\">'+(tot?Math.round(c.owed/tot*100):0)+'%</td></tr>'}).join('')||'<tr><td colspan=\"6\" class=\"empty\">No unpaid invoices yet.</td></tr>';\n var big=cl.length&&tot?cl[0][1].owed/tot:0;\n $('concNote').textContent=big>=0.5&&cl.length>1?'Heads up: '+cl[0][0]+' accounts for '+Math.round(big*100)+'% of everything you are owed. If they pay late, it hits you hardest, so keep this one on a short leash.':'';\n var sel=$('pick'),prev=sel.value;\n sel.innerHTML=state.map(function(x){return '<option value=\"'+x.i+'\">'+esc(x.client+(x.v.num?' / '+x.v.num:'')+' ('+money(x.bal)+', '+x.st.s.toLowerCase()+')')+'</option>'}).join('');\n if(prev&&state.some(function(x){return String(x.i)===prev}))sel.value=prev;\n writeMsg();\n var lines=[['Client','Invoice','Amount','Paid','Balance','Invoice date','Due date','Days late','Bucket','Stage','Last reminder','Next step']];\n state.forEach(function(x){lines.push([x.client,x.v.num,x.v.amt,x.v.paid,x.bal,x.v.date,iso(x.due),x.late,BUCKETS[x.b].name,x.st.s,x.v.rem||'',x.waiting?'Wait':x.st.a])});\n lastCSV=lines.map(function(r){return r.map(function(c){c=String(c);return /[\",\\n]/.test(c)?'\"'+c.replace(/\"/g,'\"\"')+'\"':c}).join(',')}).join('\\n');\n save();\n}\nfunction writeMsg(){\n var x=state.filter(function(s){return String(s.i)===$('pick').value})[0];\n if(!x){$('msg').value='';$('toneHint').textContent='';return}\n var me=$('me').value.trim()||'[your name]';\n var hi='Hi '+(x.v.who||'there')+',';\n var inv=x.v.num?'invoice '+x.v.num:'my invoice dated '+nice(parse(x.v.date));\n var amt=money(x.bal),due=nice(x.due);\n var part=x.v.paid>0?' (the remaining balance after the '+money(x.v.paid)+' already received, thank you for that)':'';\n var payBy=nice(addDays(parse($('asof').value)||new Date(),7));\n var T={\n  none:['Not due yet',hi+'\\n\\nJust confirming you received '+inv+' for '+amt+', due on '+due+'. Let me know if you need anything else from me to process it.\\n\\nThanks,\\n'+me],\n  heads:['Friendly, a few days before or on the due date',hi+'\\n\\nA quick heads-up that '+inv+' for '+amt+part+' is due on '+due+'. I have attached it again here so it is easy to find.\\n\\nIf it needs to go to someone else for approval, just let me know who and I will send it straight over.\\n\\nThanks so much,\\n'+me],\n  nudge:['Polite: assume it slipped through',hi+'\\n\\nI hope things are going well. I noticed '+inv+' for '+amt+part+' was due on '+due+' and I have not seen payment come through yet. It may well be on its way, in which case please ignore this.\\n\\nIf it has not been processed, could you let me know when I can expect it? I have attached the invoice again.\\n\\nThanks,\\n'+me],\n  firm:['Firm and specific, with a pay-by date',\n   hi+'\\n\\nI am following up on '+inv+' for '+amt+part+', which was due on '+due+' and is now '+x.late+' days overdue.\\n\\nCould you confirm payment will be made by '+payBy+'? If something is holding it up, such as a missing purchase order, a question about the work, or the wrong contact, tell me and I will sort it out today.\\n\\nThanks,\\n'+me],\n  call:['Escalate: talk to the person who approves payment',\n   hi+'\\n\\n'+inv.charAt(0).toUpperCase()+inv.slice(1)+' for '+amt+part+' is now '+x.late+' days past its due date of '+due+', and I have not had a reply to my earlier reminders.\\n\\nCould we have a quick call this week to get this resolved? If it would help to split the balance into two payments, I am open to that.\\n\\nUntil this is settled I will need to hold off on starting any new work, which I would much rather avoid.\\n\\nThanks,\\n'+me],\n  final:['Final notice: clear, calm, in writing',\n   hi+'\\n\\nThis is a final reminder that '+inv+' for '+amt+part+' was due on '+due+' and is now '+x.late+' days overdue.\\n\\nPlease arrange payment in full by '+payBy+'. If that is not possible, reply by then with a date you can commit to, and we can agree a payment plan in writing.\\n\\nIf I do not hear back by '+payBy+', I will [pause all work / apply the late fee set out in our agreement / take the next steps available to me].\\n\\nRegards,\\n'+me],\n  last:['Last resort: decide your route before sending',\n   hi+'\\n\\n'+inv.charAt(0).toUpperCase()+inv.slice(1)+' for '+amt+part+' has now been outstanding for '+x.late+' days past its due date of '+due+', despite several reminders.\\n\\nI would still prefer to resolve this directly. I can accept the full amount by '+payBy+', or a written payment plan that clears the balance within [number] weeks.\\n\\nIf I have no response by '+payBy+', I will [refer the debt for collection / file a small claim / other step you have checked is available to you].\\n\\nRegards,\\n'+me]\n };\n var t=T[x.st.tone];\n $('toneHint').textContent='Tone: '+t[0]+'. Replace anything in [square brackets] before sending.';\n $('msg').value=t[1];\n}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify({rows:read(),me:$('me').value,cur:$('cur').value,gap:$('gap').value}))}catch(e){}}\nfunction load(){try{var s=JSON.parse(localStorage.getItem(KEY)||'null');if(s&&s.rows&&s.rows.length){s.rows.forEach(row);if(s.me)$('me').value=s.me;if(s.cur)$('cur').value=s.cur;if(s.gap)$('gap').value=s.gap;return true}}catch(e){}return false}\nfunction example(){\n $('rows').innerHTML='';\n var t=parse($('asof').value)||new Date();\n function d(n){return iso(addDays(t,n))}\n [{client:'Harbor Coffee Co',who:'Dana',num:'INV-031',amt:1800,paid:0,date:d(-50),terms:30,rem:d(-6)},\n  {client:'Harbor Coffee Co',who:'Dana',num:'INV-036',amt:950,paid:0,date:d(-20),terms:14,rem:''},\n  {client:'Maple Physio',who:'Priya',num:'INV-033',amt:2400,paid:1200,date:d(-38),terms:30,rem:''},\n  {client:'Fieldnote Studio',who:'Marcus',num:'INV-029',amt:640,paid:0,date:d(-95),terms:30,rem:d(-20)},\n  {client:'Brightline Tutors',who:'Jo',num:'INV-037',amt:1250,paid:0,date:d(-12),terms:14,rem:''},\n  {client:'Maple Physio',who:'Priya',num:'INV-038',amt:1200,paid:0,date:d(-5),terms:30,rem:''}\n ].forEach(row);\n calc();\n}\nfunction copy(text,ok){\n var m=$('copied');\n function fb(){var ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');m.textContent=ok}catch(e){m.textContent='Copy failed. Select the text and copy it instead.'}ta.remove()}\n if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(function(){m.textContent=ok},fb)}else fb();\n}\n$('asof').value=iso(new Date());\ndocument.addEventListener('input',function(e){if(e.target.id==='msg')return;if(e.target.closest('main'))calc()});\ndocument.addEventListener('change',function(e){if(e.target.id==='pick'){writeMsg();return}if(e.target.id==='msg')return;if(e.target.closest('main'))calc()});\ndocument.addEventListener('click',function(e){\n var b=e.target.closest('button');if(!b)return;\n if(b.classList.contains('x')){b.closest('.inv').remove();calc()}\n else if(b.id==='add'){row({date:iso(new Date()),terms:30,paid:0});calc()}\n else if(b.id==='example')example();\n else if(b.id==='clear'){$('rows').innerHTML='';row({date:iso(new Date()),terms:30,paid:0});calc()}\n else if(b.id==='copyMsgBtn')copy($('msg').value,'Message copied.');\n else if(b.id==='copyCsv')copy(lastCSV,'Report copied. Paste into a spreadsheet.');\n});\nif(load())calc();else example();\n})();\n</script>\n</body></html>\n"
}