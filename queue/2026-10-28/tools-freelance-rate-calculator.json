{
 "lane": "tools",
 "slug": "freelance-rate-calculator",
 "title": "Freelance Rate Calculator",
 "description": "Find the hourly and day rate you need to reach your take-home pay goal after expenses, taxes, time off and unbilled hours.",
 "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Freelance Rate Calculator</title>\n<style>\n:root{--bg:#fbfaf7;--card:#ffffff;--fg:#22212b;--dim:#6b6878;--line:#e4e1d8;--accent:#2f8a4c;--soft:#eef6f0}\n@media (prefers-color-scheme:dark){:root{--bg:#17161f;--card:#201f2b;--fg:#ebe8df;--dim:#a19db0;--line:#33313f;--accent:#4fbf74;--soft:#1f2d24}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:24px 16px 40px}\nh1{margin:0 0 4px;font-size:28px}\np.lead{margin:0 0 20px;color:var(--dim)}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}\nlabel{display:block;font-size:14px;font-weight:600}\nlabel span{display:block;font-weight:400;color:var(--dim);font-size:13px}\ninput{width:100%;margin-top:6px;padding:10px;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--fg)}\ninput:focus{outline:2px solid var(--accent);outline-offset:1px}\n.out{margin-top:24px;padding:18px;border-radius:8px;background:var(--soft);display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}\n.out div b{display:block;font-size:28px;font-variant-numeric:tabular-nums}\n.out div small{color:var(--dim)}\ntable{width:100%;border-collapse:collapse;margin-top:18px;font-variant-numeric:tabular-nums}\ntd{padding:8px 4px;border-bottom:1px solid var(--line)}td:last-child{text-align:right}\n.note{font-size:14px;color:var(--dim);margin-top:18px}\n</style></head>\n<body><main>\n<h1>Freelance Rate Calculator</h1>\n<p class=\"lead\">Work out the hourly and day rate you need to hit your income goal, after expenses, taxes and unbilled time.</p>\n<div class=\"grid\">\n<label for=\"income\">Take-home pay goal per year<span>What you want left after tax</span><input id=\"income\" type=\"number\" min=\"0\" step=\"1000\" value=\"60000\"></label>\n<label for=\"expenses\">Business expenses per year<span>Software, equipment, insurance, health cover</span><input id=\"expenses\" type=\"number\" min=\"0\" step=\"100\" value=\"8000\"></label>\n<label for=\"tax\">Tax rate (%)<span>Your rough combined rate on profit</span><input id=\"tax\" type=\"number\" min=\"0\" max=\"70\" step=\"1\" value=\"28\"></label>\n<label for=\"hours\">Hours you work per week<span>All working time, billed or not</span><input id=\"hours\" type=\"number\" min=\"1\" max=\"80\" step=\"1\" value=\"40\"></label>\n<label for=\"billable\">Billable share (%)<span>Most freelancers bill 50-70% of their time</span><input id=\"billable\" type=\"number\" min=\"5\" max=\"100\" step=\"5\" value=\"60\"></label>\n<label for=\"weeksoff\">Weeks off per year<span>Holidays, sick days, public holidays</span><input id=\"weeksoff\" type=\"number\" min=\"0\" max=\"30\" step=\"1\" value=\"6\"></label>\n<label for=\"buffer\">Safety buffer (%)<span>Covers quiet months and late payers</span><input id=\"buffer\" type=\"number\" min=\"0\" max=\"50\" step=\"5\" value=\"10\"></label>\n<label for=\"hpd\">Hours in a billable day<span>Used for the day rate</span><input id=\"hpd\" type=\"number\" min=\"1\" max=\"12\" step=\"0.5\" value=\"7\"></label>\n</div>\n<div class=\"out\" aria-live=\"polite\">\n<div><small>Minimum hourly rate</small><b id=\"hourly\">-</b></div>\n<div><small>Day rate</small><b id=\"day\">-</b></div>\n<div><small>Revenue needed per year</small><b id=\"revenue\">-</b></div>\n</div>\n<table><tbody>\n<tr><td>Billable hours per year</td><td id=\"bh\">-</td></tr>\n<tr><td>Before-tax profit needed</td><td id=\"pretax\">-</td></tr>\n<tr><td>Revenue needed per month (working months)</td><td id=\"monthly\">-</td></tr>\n<tr><td>A project of 20 hours should cost at least</td><td id=\"proj\">-</td></tr>\n</tbody></table>\n<p class=\"note\">This gives a floor, not a ceiling. Price above it when the work is specialist, urgent or high-value to the client. Tax here is a rough single rate. Check your real rate with a local tax professional.</p>\n</main>\n<script>\n(function(){\n  var ids=[\"income\",\"expenses\",\"tax\",\"hours\",\"billable\",\"weeksoff\",\"buffer\",\"hpd\"];\n  var fmt=function(n,d){return isFinite(n)?n.toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d}):\"-\";};\n  function v(id){var x=parseFloat(document.getElementById(id).value);return isNaN(x)?0:x;}\n  function set(id,t){document.getElementById(id).textContent=t;}\n  function calc(){\n    var tax=Math.min(v(\"tax\"),95)/100;\n    var pretax=v(\"income\")/(1-tax);\n    var revenue=(pretax+v(\"expenses\"))*(1+v(\"buffer\")/100);\n    var weeks=Math.max(52-v(\"weeksoff\"),1);\n    var bh=v(\"hours\")*(v(\"billable\")/100)*weeks;\n    var hourly=bh>0?revenue/bh:NaN;\n    set(\"hourly\",fmt(hourly,2));\n    set(\"day\",fmt(hourly*v(\"hpd\"),0));\n    set(\"revenue\",fmt(revenue,0));\n    set(\"bh\",fmt(bh,0));\n    set(\"pretax\",fmt(pretax,0));\n    set(\"monthly\",fmt(revenue/(weeks/52*12),0));\n    set(\"proj\",fmt(hourly*20,0));\n  }\n  ids.forEach(function(id){document.getElementById(id).addEventListener(\"input\",calc);});\n  calc();\n})();\n</script>\n</body></html>"
}